# Public names. Create the A/AAAA records before requesting certificates.
PANEL_DOMAIN=panel.example.com
MAIL_HOST=mail.example.com
WEBMAIL_DOMAIN=webmail.example.com
ACME_EMAIL=admin@example.com
POSTMASTER_ADDRESS=postmaster@example.com

# Stable host paths. Keep them outside the Git checkout.
PLATFORM_STATE_DIR=/opt/paneltutor/state
PANELTUTOR_ROOT=/opt/paneltutor/app

# Pinned images observed in the functional production environment.
TRAEFIK_IMAGE=traefik:v3.7.8
DMS_IMAGE=ghcr.io/docker-mailserver/docker-mailserver:15.1.0
ROUNDCUBE_IMAGE=roundcube/roundcubemail:1.7.2-apache
PHPMYADMIN_IMAGE=phpmyadmin:5.2.3

# Optional local-only phpMyAdmin diagnostic port. Never bind to 0.0.0.0.
PHPMYADMIN_LOCAL_PORT=8081
