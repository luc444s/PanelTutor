[Unit]
Description=Re-apply Spanel host agent units from the installed repository
Documentation=man:systemd.service(5)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Idempotent: the installer only restarts units whose rendered unit changed.
# Drop-ins under *.service.d/ are operator-owned and are never modified.
ExecStart=<python> <repo>/scripts/install_tenant_agents.py --force --json
