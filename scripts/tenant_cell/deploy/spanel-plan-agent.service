[Unit]
Description=Spanel host plan agent (privileged boundary for tenant resource plans)
Documentation=man:systemd.service(5)
After=network.target

[Service]
Type=simple
# Privileges are bounded: this service, not the app container, owns plan
# materialization. The app container only talks to the Unix socket below.
User=root
Group=root
UMask=0077
NoNewPrivileges=true
# A.SPEC 0118: `provision` creates users/groups (/etc), cell homes,
# /run/user/<uid>, nftables skuid rules, AppArmor profiles and cgroups. The
# old plan-only sandbox made `groupadd` fail with "cannot lock /etc/group"
# (exit 10) and `nft` fail with exit 3 (AF_NETLINK blocked). Peer credentials,
# the HMAC capability and the local mutation gate remain the authorization.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_MAC_ADMIN
AmbientCapabilities=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_MAC_ADMIN
PrivateTmp=true
ProtectHome=false
ProtectSystem=off
# AF_UNIX is the control socket; AF_INET/AF_INET6 are required by the
# optional rootless phpMyAdmin broker, which queries Postgres over TCP;
# AF_NETLINK is required by nft (NETLINK_NETFILTER) for per-cell skuid rules.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictSUIDSGID=true
# A.SPEC 0102: the local mutation gate exists ONLY in this host process.
Environment=SPANEL_TENANT_ALLOW_LOCAL_MUTATIONS=1
Environment=SPANEL_PLAN_AGENT_SOCKET=/run/spanel/plan-agent.sock
Environment=SPANEL_PLAN_AGENT_TOKEN_FILE=/etc/spanel/plan_agent_token
Environment=SPANEL_PLAN_AGENT_ALLOWED_UIDS=<app-container-uid>
# /run/spanel is owned by the edge-relay unit (it runs as Traefik's uid). This
# root unit only writes its socket; it must not declare RuntimeDirectory, or
# systemd would chown the shared directory back to root.
ExecStart=/usr/bin/python3 /opt/spanel/scripts/spanel_tenant.py plan-agent --data-root /var/lib/spanel
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
