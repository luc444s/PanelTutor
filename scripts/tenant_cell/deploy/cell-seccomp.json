        "madvise", "memfd_create", "mincore", "mkdir", "mkdirat", "mlock",
        "mlockall", "mmap", "mprotect", "mremap", "msgctl", "msgget",
        "msgrcv", "msgsnd", "msync", "munlock", "munlockall", "munmap",
        "nanosleep", "open", "openat", "pause", "personality", "pidfd_open",
        "pidfd_send_signal", "pipe", "pipe2", "pivot_root", "poll", "ppoll",
