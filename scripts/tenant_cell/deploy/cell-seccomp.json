      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "comment": "clone3: return ENOSYS so glibc falls back to clone() instead of failing with EPERM.",
      "names": ["clone3"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 38
    },
    {
      "comment": "userfaultfd: return ENOSYS; not required by any supported image and dangerous in userns.",
      "names": ["userfaultfd"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 38
    },
    {
      "comment": "Explicitly block kernel interfaces that are hazardous inside a user namespace.",
      "names": [
        "bpf", "perf_event_open", "io_uring_setup", "io_uring_enter",
        "io_uring_register", "kexec_load", "kexec_file_load", "init_module",
        "finit_module", "delete_module", "open_by_handle_at", "fanotify_init",
        "add_key", "request_key", "keyctl", "syslog"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    }
  ]
