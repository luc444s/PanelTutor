{
  "comment": "Rootless cell seccomp profile (A.SPEC 0105). Fail-closed: everything not in the allowlist returns EPERM. The AppArmor profile confines paths/mounts; seccomp reduces the syscall surface. clone3/userfaultfd return ENOSYS so glibc/runtimes fall back safely on hosts whose seccomp filter cannot inspect their arguments.",
  "defaultAction": "SCMP_ACT_ERRNO",
  "architectures": [
    "SCMP_ARCH_X86_64",
    "SCMP_ARCH_AARCH64"
  ],
  "syscalls": [
    {
      "comment": "Allowlist shared by rootlesskit, slirp4netns, runc, containerd, nginx, php-fpm, MariaDB, node and Gitea.",
      "names": [
        "accept", "accept4", "access", "acct", "alarm", "arch_prctl",
        "bind", "brk", "capget", "capset", "chdir", "chmod", "chown",
        "chroot", "clock_getres", "clock_gettime", "clock_nanosleep",
        "clock_settime", "close", "close_range", "connect", "copy_file_range",
        "creat", "dup", "dup2", "dup3", "epoll_create", "epoll_create1",
        "epoll_ctl", "epoll_pwait", "epoll_pwait2", "epoll_wait", "eventfd",
        "eventfd2", "execve", "execveat", "exit", "exit_group", "faccessat",
